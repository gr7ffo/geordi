	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "GEORDI_DATA_DIR=../../.data vite dev",
		"build": "vite build",
		"preview": "vite preview",

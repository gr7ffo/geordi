{
	"name": "@geordi/desktop",
	"version": "0.8.0",
	"private": true,
	"type": "module",
	"main": "src/main.js",
	"scripts": {
		"test": "node --test scripts/*.test.js",
		"dev:app": "node scripts/dev.js",
		"start": "node scripts/build.js && electron stage",
		"package": "node scripts/build.js --package",

		"app:install": "node scripts/build.js --install"
	},
	"devDependencies": {
		"@electron/osx-sign": "2.7.2",
		"@electron/packager": "^20.3.0",
		"@geordi/launch": "workspace:*",
		"@types/node": "catalog:",
		"electron": "45.4.1",
		"electron-builder": "^26.18.0",
		"electron-updater": "^6.8.11",
		"esbuild": "^0.28.2"
	},
	"description": "A calmer way to run coding agents.",
	"homepage": "https://geordi.run",
